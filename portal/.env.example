# On cPanel, enter these as individual Node app environment variables.
# DATABASE_URL is supported instead if your host provides a connection URL.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=CPANEL_USER_portal
PGUSER=CPANEL_USER_portalapp
PGPASSWORD=replace_with_database_password
PORTAL_UPLOAD_DIR=/home/CPANEL_USER/portal-private-files
PAYLOAD_SECRET=replace_with_at_least_32_random_bytes
PORTAL_URL=https://portal.pofco.ir
# Optional until the Microsoft mailbox is ready. Outbound email is disabled without these.
# MS_GRAPH_CLIENT_ID=replace_with_microsoft_app_client_id
# MS_GRAPH_CLIENT_SECRET=replace_with_microsoft_app_client_secret
# MS_GRAPH_MAILBOX=replace_with_shared_outlook_address
# Optional for a single-tenant Microsoft 365 app; defaults to common.
# MS_GRAPH_TENANT_ID=replace_with_directory_guid
# openssl rand -hex 32
# PORTAL_ENCRYPTION_KEY=replace_with_64_hex_characters
# openssl rand -hex 32; set this in the scheduled inbox sync request header.
# MAIL_SYNC_KEY=replace_with_an_independent_random_secret
# Temporary one-time setup token. Remove after creating the first administrator.
PORTAL_BOOTSTRAP_TOKEN=replace_with_an_independent_64_hex_character_secret
